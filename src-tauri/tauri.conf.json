{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "素笺",
  "version": "0.9.0",
  "identifier": "com.souffle.slip",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "node scripts/make-helper.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "bubble",
        "title": "素笺",
        "url": "bubble.html",
        "width": 380,
        "height": 200,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "center": false
      },
      {
        "label": "sel-icon",
        "title": "素笺",
        "url": "icon.html",
        "width": 36,
        "height": 36,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "center": false
      },
      {
        "label": "main",
        "title": "素笺",
        "url": "app.html",
        "width": 1020,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "visible": false,
        "center": true,
        "resizable": true
      },
      {
        "label": "permission",
        "title": "素笺需要系统权限",
        "url": "permission.html",
        "width": 460,
        "height": 300,
        "resizable": false,
        "visible": false,
        "center": true,
        "minimizable": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "全局划词翻译",
    "longDescription": "选中任意应用里的文字，立刻弹出译文。默认免费线路，可选 DeepSeek 精翻与术语表。",
    "macOS": {
      "signingIdentity": "Slip Dev"
    },
    "resources": [
      "resources/ecdict.sqlite"
    ]
  }
}
